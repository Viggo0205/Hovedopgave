# GitHub API Configuration
# Personal Access Token for GitHub API access
# Required permissions: public_repo, read:user, read:org
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_ACCESS_TOKEN=ghp_your_github_token_here

# MCP Server Configuration
# Set to false for real GitHub API calls, true for mock data
MOCK_MODE=false

# Jira API Configuration (Optional - not currently used)
# Server URL for your Atlassian instance
JIRA_SERVER_URL=https://your-domain.atlassian.net
# Email address associated with your Jira account
JIRA_EMAIL=your-email@domain.com
# API token for Jira authentication
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# Database Configuration
# PostgreSQL connection string
# Change 'password' to your actual PostgreSQL password
DATABASE_URL=postgresql://postgres:password@localhost:5432/developer_skills

# Optional: API Rate Limiting
API_RATE_LIMIT=100  # requests per minute
GITHUB_RATE_LIMIT=5000  # requests per hour (GitHub default)
JIRA_RATE_LIMIT=200  # requests per minute

# Optional: Caching
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600  # 1 hour

# Optional: Logging
LOG_LEVEL=INFO
LOG_FILE=logs/skill_analyzer.log

# Optional: Analysis Settings
DEFAULT_TIME_RANGE_MONTHS=12
MAX_REPOSITORIES_ANALYZED=50
MAX_ISSUES_ANALYZED=200
