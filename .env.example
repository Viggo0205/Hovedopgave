# GitHub API
GITHUB_ACCESS_TOKEN=your_github_personal_access_token_here

# Jira API
JIRA_SERVER_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@domain.com
JIRA_API_TOKEN=your_jira_api_token_here

# Optional: API Rate Limiting
API_RATE_LIMIT=100  # requests per minute
GITHUB_RATE_LIMIT=5000  # requests per hour (GitHub default)
JIRA_RATE_LIMIT=200  # requests per minute

# Optional: Caching
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600  # 1 hour

# Optional: Logging
LOG_LEVEL=INFO
LOG_FILE=logs/skill_analyzer.log

# Optional: Analysis Settings
DEFAULT_TIME_RANGE_MONTHS=12
MAX_REPOSITORIES_ANALYZED=50
MAX_ISSUES_ANALYZED=200