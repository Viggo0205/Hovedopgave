{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/schemas/developer-profile.json",
  "title": "Developer Competence Profile",
  "description": "Sanitized developer skill profile for external data analysis. Contains NO personal identifiable information (PII).",
  "type": "object",
  "required": ["username", "language_skills", "analysis_date"],
  "properties": {
    "username": {
      "type": "string",
      "description": "Developer's public username (GitHub/Jira handle)",
      "examples": ["johndoe", "jane-developer"]
    },
    "display_name": {
      "type": ["string", "null"],
      "description": "Public display name (optional)",
      "examples": ["John Doe", "Jane Developer"]
    },
    "language_skills": {
      "type": "object",
      "description": "Programming language proficiencies",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "examples": ["Python", "JavaScript", "Java"]
          },
          "level": {
            "type": "string",
            "enum": ["beginner", "intermediate", "advanced", "expert"],
            "description": "Skill proficiency level"
          },
          "lines_of_code": {
            "type": "integer",
            "minimum": 0,
            "description": "Total lines of code written"
          },
          "repositories_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Number of repositories using this language"
          },
          "percentage_of_work": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Percentage of total work in this language"
          },
          "last_used": {
            "type": ["string", "null"],
            "format": "date-time",
            "description": "ISO 8601 timestamp of last usage"
          }
        }
      }
    },
    "expertise_areas": {
      "type": "object",
      "description": "Technical expertise categories",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "examples": ["Web Development", "Data Science", "Mobile Development"]
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "proficiency": {
            "type": "string",
            "enum": ["beginner", "intermediate", "advanced", "expert"]
          },
          "project_count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "total_repositories": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of repositories contributed to"
    },
    "total_commits": {
      "type": "integer",
      "minimum": 0,
      "description": "Total commits made across all repositories"
    },
    "total_pull_requests": {
      "type": "integer",
      "minimum": 0,
      "description": "Total pull requests created"
    },
    "total_issues": {
      "type": "integer",
      "minimum": 0,
      "description": "Total issues worked on"
    },
    "account_age_days": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Days since account creation"
    },
    "last_activity": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 timestamp of last recorded activity"
    },
    "analysis_date": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this analysis was performed"
    },
    "data_sources": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["github", "jira", "gitlab", "bitbucket"]
      },
      "description": "Data sources used for analysis"
    }
  },
  "examples": [
    {
      "username": "johndoe",
      "display_name": "John Doe",
      "language_skills": {
        "Python": {
          "language": "Python",
          "level": "expert",
          "lines_of_code": 50000,
          "repositories_count": 15,
          "percentage_of_work": 45.5,
          "last_used": "2025-12-08T10:30:00Z"
        },
        "JavaScript": {
          "language": "JavaScript",
          "level": "advanced",
          "lines_of_code": 30000,
          "repositories_count": 10,
          "percentage_of_work": 27.3,
          "last_used": "2025-12-07T15:20:00Z"
        }
      },
      "expertise_areas": {
        "Web Development": {
          "category": "Web Development",
          "languages": ["JavaScript", "TypeScript", "HTML", "CSS"],
          "proficiency": "advanced",
          "project_count": 12
        },
        "Data Science": {
          "category": "Data Science",
          "languages": ["Python", "R", "SQL"],
          "proficiency": "expert",
          "project_count": 8
        }
      },
      "total_repositories": 25,
      "total_commits": 1250,
      "total_pull_requests": 89,
      "total_issues": 145,
      "account_age_days": 1825,
      "last_activity": "2025-12-08T10:30:00Z",
      "analysis_date": "2025-12-08T10:30:00Z",
      "data_sources": ["github"]
    }
  ],
  "definitions": {
    "skill_level": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced", "expert"],
      "description": "Standard skill proficiency levels used throughout the system"
    }
  },
  "additionalProperties": false,
  "$comment": "This schema ensures data consistency and GDPR compliance by excluding all PII fields such as email, phone, address, etc."
}
